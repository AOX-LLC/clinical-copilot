# Copy to .env for live mode. Never commit .env.
ANTHROPIC_API_KEY=
# true = replay recorded model responses, no key needed
MOCK_MODE=true

# --- Docker Compose stack (required: compose refuses to start without them) ---
# Set both before the first start, e.g. with `openssl rand -hex 24`. Compose refuses to start
# while either is empty. The app role's password is applied only when the database volume
# is first created; to change it later, ALTER ROLE copilot_app or recreate the volume.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
CLINIC_TIMEZONE=America/New_York
# Optional fixed "today" (YYYY-MM-DD) for reproducible demos
CLINIC_TODAY=
# Tests: pytest uses this to create a throwaway test database
# TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://copilot_owner:<POSTGRES_PASSWORD>@127.0.0.1:4602/postgres
